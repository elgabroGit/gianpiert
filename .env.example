# Copia questo file in .env e compila i valori.

# Porta HTTP del server
PORT=3000

# Chiave per firmare il cookie di sessione. Genera un valore con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Durata della sessione in giorni
SESSION_DAYS=30

# Metti 1 se il sito è servito in HTTPS (dietro un proxy come Caddy o nginx)
COOKIE_SECURE=0

# Percorso del file SQLite, relativo alla cartella del progetto
DB_FILE=data/lana.sqlite

# Utenti iniziali, usati solo se nel database non c'è ancora nessun utente.
# Formato nome:hashbcrypt separati da virgola. L'hash si ottiene con: npm run user -- hash <nome>
# In alternativa lascia vuoto e crea gli utenti con: npm run user -- add gianpiero
INITIAL_USERS=
